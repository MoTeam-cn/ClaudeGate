# ============ 监听 ============
PORT=8080
HOST=0.0.0.0
# 对外展示用（面板与文档里的接入地址）；TLS 建议交给 Caddy/Nginx 终止
PUBLIC_URL=https://gw.example.com

# ============ 安全 ============
# 网关令牌签名密钥；留空则首次启动自动生成到 data/secret
SECRET=
# 面板登录密钥不用在这里填 —— 首次启动会自动派发一个，在控制台日志里打印一次。
# 密钥派生自主密钥（下面那个 ADMIN_SECRET），单向不可逆；盘上只留 scrypt 哈希。
# 忘了就去面板「设置」里重置（可自定义），或删掉 data/admin.json 重启重新派发。
# ADMIN_TOKEN 是逃生口：显式设了它就完全接管鉴权，不派发也不打印。
ADMIN_TOKEN=
# 主密钥。留空则首次启动自动生成：写进 data/admin.json（0600），并镜像到本文件。
# 改了它，面板登录密钥会跟着重新派生并在日志里再打印一次。
ADMIN_SECRET=
# 读哪个 .env。留空字符串表示既不读也不写（测试用）。默认是工作目录的 .env。
# 显式指定它时，主密钥一定会镜像写进这个文件。
CG_ENV_FILE=
# 网关令牌有效期（天）
TOKEN_TTL_DAYS=365
# 是否信任 x-forwarded-for / x-real-ip 作为客户端 IP（放在 Caddy/Nginx 后面时保持 true）
TRUST_PROXY=true

# ============ 上游 ============
UPSTREAM_BASE=https://api.anthropic.com
# 出站代理。四种都支持：
#   http://user:pass@host:port      标准 HTTP 代理（CONNECT 隧道）
#   https://user:pass@host:port     代理本身走 TLS，再在隧道里发 CONNECT
#   socks5://user:pass@host:port    本地解析域名，再按 IP 连
#   socks5h://user:pass@host:port   把域名交给代理解析（推荐，不泄露 DNS）
# 留空则直连。UPSTREAM_PROXY 为空时依次回退 ALL_PROXY / HTTPS_PROXY / HTTP_PROXY。
# 说明：OAuth 兑换、令牌刷新、用量查询也一并走这里，不会绕过代理。
UPSTREAM_PROXY=
# 出口自检（保底）。启动时分别用「带代理」和「不带代理」各查一次出口 IP：
# 两次相同 -> 说明请求根本没走代理，流量从本机直出 -> 按下面的开关处理。
#   block（默认）判为代理没生效就拒绝启动 | warn 只告警 | off 跳过
# 查不出结论的情况（比如内网机器没有直连出口）不算失败，只记一行日志。
IP_CHECK=block
# IP 回显服务。返回 {ip:"..."} / {query:"..."} 或纯 IP 文本都可以
IP_CHECK_URL=https://ipinfo.io/json
# 固定 TLS 参数，保证到上游的指纹稳定（不要随意改）
TLS_MIN=TLSv1.2
TLS_MAX=TLSv1.3
UPSTREAM_ALPN=http/1.1
UPSTREAM_TIMEOUT_MS=600000
# 到上游的最大并发连接（按落地机内存与上游限额调）
UPSTREAM_MAX_SOCKETS=64

# ============ 占用与限流 ============
# 单请求体上限（字节），默认 32MB
MAX_BODY_BYTES=33554432
# 优雅退出宽限期（毫秒）
SHUTDOWN_GRACE_MS=5000

# ============ Claude Code 请求头守卫 ============
# 只对「指纹策略 = claude_code」的 API Key 生效；
# strict: 缺头直接 403 | lenient: 缺头放行并告警 | off: 完全不校验
GUARD_MODE=strict
# 只要求「表明自己是 Claude Code」的两个身份头。
# anthropic-version / anthropic-beta / x-claude-code-session-id 由网关自己补 ——
# session-id 是从 Key 种子派生的，让客户端提供只会被塞个随机值，反而破坏跨请求稳定性。
GUARD_REQUIRE=user-agent,x-app
# 为缺失的头注入规范值（指纹策略为 passthrough 的 Key 一律强制注入，与此开关无关）
INJECT_MISSING=false

# ============ 隐写拦截 ============
# Claude Code 2.1.91-2.1.196 会把「中国时区 / 命中域名名单」隐写进系统提示词日期行。
# block: 命中直接拒绝并说明原因（默认）| strip: 清洗后转发 | log: 只记录 | off: 不检测
STEGO_MODE=block

# ============ 请求 ID ============
# 请求 ID 只进响应体、不进响应头。
# error: 只有错误响应带（默认，保证成功响应原样透传）| always: 成功响应也带 | off: 不带
REQ_ID_IN_RESPONSE=error

# ============ OAuth ============
# claude_ai（订阅账号，走 Bearer 推理）| console（兑换 API Key）| design
OAUTH_MODE=claude_ai
OAUTH_CLIENT_ID=
OAUTH_SCOPES=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_MANUAL_REDIRECT=https://platform.claude.com/oauth/code/callback
# 订阅账号档案端点，用来把占位账号名换成真实用户名（display_name / full_name）
OAUTH_PROFILE_URL=https://api.anthropic.com/api/oauth/profile

# ============ 请求体身份校验 ============
# 确认调用方真是 Claude Code，而不是手搓的脚本。只看两件事：
#   1. system 首段是**完整**的归因头（前缀 + cc_version + cc_entrypoint + 指纹段）
#      —— 归因头本身是网关补的，但客户端塞个只有前缀的空壳就能把注入顶掉，
#         所以这一条是在堵那个绕过。
#   2. system 里有一段正好等于 Claude Code 的身份行（三个变体之一）。
# 只作用在 /v1/messages，且只对走守卫的 Key 生效（passthrough 的 Key 跳过）。
# block 拒绝（默认）/ log 只记日志 / off 不查
#
# 注意这是**提高门槛**，不是安全边界 —— 真下决心的人照着抄照样能过。
# 目标是挡掉随手 curl 和拿别的客户端蹭的。
IDENTITY_MODE=block

# ============ 模型上下文与输出 ============
# 每个模型配一对「上下文窗口 / 最大输出」。语法：
#   <模型>=<上下文>[/<最大输出>] ，逗号分隔；"*" 是兜底项。
#   尺寸写法：256000 / 256k / 1m / 256（100-1000 的裸数字当 k）。
#   带不带 [1m] 后缀、带不带日期后缀都算同一个模型。
#
# 为什么要在这里配：Claude Code 的自动压缩窗口是**按模型名**去它自己的目录里查的，
# 查得到就用目录值（claude-opus-5-5 是 1M），查不到才用通用兜底。我们实际打到
# 上游的是第三方模型，窗口跟名字对不上，会话就会一路长下去都不压缩。
# 客户端可以用 CLAUDE_CODE_AUTO_COMPACT_WINDOW 钉死，但那是每台机器配一遍；
# 网关这边钉死才是唯一真相源。
MODEL_LIMITS=
# 超限怎么处理：block 拒绝（默认）/ log 只记日志 / off 完全不查
CONTEXT_GUARD=block
# 超限容差。0.1 = 允许超出 10% 才拒绝。
# 客户端的计数跟真实计数不会完全一致，卡死在正好 256K 会把压缩前后的正常请求也打掉。
CONTEXT_HEADROOM=0.1
# 最大输出（上面 / 后面的那个值）目前**只对外声明、不做限制**。
# 以后要限的话再在这个模块里加。

# ============ 模型 ============
DEFAULT_MODEL=claude-sonnet-4-5-20250929
MAX_TOKENS_DEFAULT=8192

# ============ 其他 ============
DATA_DIR=./data
LOG_LEVEL=info

# ============ 面板里可改（写库，启动时优先于上面同名项） ============
# guardMode / stegoMode / reqIdInResponse / injectMissing / logRetentionDays / runtimeLogMax

# ============ 模型目录 ============
# /v1/models 返回的清单。网关从 Claude Code 自己用的那份远端目录拉取：
#   https://downloads.claude.ai/model-catalog/v1/catalog.json
# 进程内只留一份，请求打过来时只读内存，不会每次都去拉。过期后会在后台刷一次；
# 拉不到就退回内置清单（内置清单跟 Claude Code 2.1.293 编译进去的那份对齐）。
# 想换成自己的目录地址就改这里。
MODEL_CATALOG_URL=https://downloads.claude.ai/model-catalog/v1/catalog.json

# 目录多久算过期（毫秒），默认 6 小时。
MODEL_CATALOG_TTL_MS=21600000

# 消息接口的模型校验：
#   strict（默认）= /v1/messages 与 /v1/chat/completions 的 model 必须在上面那份清单里，
#                  否则 400 invalid_request_error。别名、日期后缀、[1m] 后缀都算数。
#   off          = 不校验，照原样转发。
MODEL_VALIDATION=strict

# 部署级隐藏清单（逗号分隔）。这里钉死的模型面板里改不动，用来兜住
# 「这个账号永远用不了某个模型」这类情况，例如：
#   MODEL_DISABLED=claude-fable-5,claude-fable-5-1,claude-mythos-5,claude-mythos-5-1
# 面板「设置 → 模型目录」里勾掉的跟这里取并集。
MODEL_DISABLED=
